# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# llm-launcher 実行データ (プロファイル・起動履歴・ログ)
/data/
# モジュール内ビルド成果物
module/*/build/
module/*/build-*/
*.egg-info/

# フォーク専用クローン置き場 module/fork/
# 追跡は module/fork/ フォルダまで (.gitkeep と README.md)。
# 配下に clone したフォークリポジトリ自体は一切追跡しない (submodule 化もしない)
module/fork/*/

# Maya の実行時データ置き場 module/Maya-data/
# GGUF 重み・トークナイザ等の巨大なモデルファイルを置くため一切追跡しない。
module/Maya-data/

# 開発用スクラッチ (検証スクリプト・テスト一時ファイル)
.scratch/

# バックエンド実験環境置き場 experiments/
# 追跡は experiments/ フォルダの目印 (.gitkeep) まで。
# 配下に作る実験環境 (クローン・venv・ビルド成果物・ログ・チェックポイント等) は一切追跡しない。
/experiments/*
!/experiments/.gitkeep
